{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . ",
    "lint:fix": "eslint .  --fix",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,css}\" --ignore-path .gitignore",
    "format:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\" --ignore-path .gitignore",
    "test:unit": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "test:e2e:ui": "playwright test --ui",
    "validate": "npm audit && npm run lint && npm run format:check && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^7.1.0",
    "@react-google-maps/api": "^2.20.8",
    "@supabase/supabase-js": "^2.100.0",
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.34.3",
    "graphql-request": "^7.4.0",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.564.0",
    "next": "^16.1.6",
    "openai": "^6.31.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "vitest": "^4.1.10"
  }
}
